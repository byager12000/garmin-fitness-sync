# Copy to .env and fill in. .env is gitignored -- never commit real values.
#
# Phase 1 only needs the Garmin side. Notion settings arrive in Phase 3.

# ---------------------------------------------------------------- Garmin
# Only needed for the FIRST login on a machine (and after a token expiry that
# cannot be refreshed). Once the token store exists, the sync runs without
# them -- you can leave the password blank afterwards if you prefer.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Where the Garmin session tokens are cached. Defaults to ~/.garminconnect.
# On Termux this should be inside the Termux home, not shared storage.
# GARMINTOKENS=~/.garminconnect

# ---------------------------------------------------------------- Notion
# Internal integration secret from https://www.notion.so/my-integrations
# (starts with "ntn_"). The integration needs only Read + Update content, and
# only the Fitness Live page should be shared with it -- nothing else in the
# Nexus. Phase 3 onwards.
NOTION_TOKEN=

# The page the sync updates in place. Leave the default unless you renamed it;
# the sync looks the page up by title via the integration's own access, so you
# do not need to paste a page ID.
NOTION_PAGE_TITLE=Fitness Live

# Optional: pin the destination by ID instead of title, if you ever end up
# with two pages of the same name.
# NOTION_PAGE_ID=

# ------------------------------------------------------------- behaviour
# Days of activity history fetched each run, used for the rolling summary.
ACTIVITY_LOOKBACK_DAYS=7

# Leave unset in normal use. The sync follows the device's own timezone so a
# travel day follows you. Set an IANA name only to make testing reproducible.
# FITNESS_TZ=America/New_York
